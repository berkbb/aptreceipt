          }
        }
      }
    },
    "updateDownloadedMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ was saved to your Downloads folder and opened.\n\nQuit AptReceipt, drag the new version onto Applications and choose Replace, then open it again.\n\nIf macOS blocks the first launch, allow it in System Settings → Privacy & Security → Open Anyway."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a fost salvat în dosarul Descărcări și deschis.\n\nÎnchideți AptReceipt, trageți noua versiune în Applications (Aplicații) și alegeți Înlocuire, apoi deschideți-o din nou.\n\nDacă macOS blochează prima lansare, permiteți-o din Configurări sistem → Confidențialitate și securitate → Deschide oricum."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ İndirilenler klasörüne kaydedildi ve açıldı.\n\nAptReceipt'ten çıkın, yeni sürümü Applications (Uygulamalar) klasörüne sürükleyip Değiştir'i seçin, ardından yeniden açın.\n\nmacOS ilk açılışı engellerse Sistem Ayarları → Gizlilik ve Güvenlik → Yine de Aç ile izin verin."
          }
        }
      }
    },
    "updateDownloadedNotOpenedMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ was saved to your Downloads folder, but macOS blocked opening it because the update is not notarized by Apple.\n\nOpen System Settings → Privacy & Security and click Open Anyway for the disk image (or run xattr -d com.apple.quarantine on it in Terminal). Then quit AptReceipt, drag the new version onto Applications and choose Replace."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a fost salvat în dosarul Descărcări, dar macOS a blocat deschiderea deoarece actualizarea nu este notarizată de Apple.\n\nDeschideți Configurări sistem → Confidențialitate și securitate și apăsați Deschide oricum pentru imaginea de disc (sau rulați xattr -d com.apple.quarantine pe fișier în Terminal). Apoi închideți AptReceipt, trageți noua versiune în Applications (Aplicații) și alegeți Înlocuire."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ İndirilenler klasörüne kaydedildi, ancak güncelleme Apple tarafından notarize edilmediği için macOS açılmasını engelledi.\n\nSistem Ayarları → Gizlilik ve Güvenlik bölümünde disk görüntüsü için Yine de Aç'a tıklayın (veya Terminal'de dosyaya xattr -d com.apple.quarantine uygulayın). Ardından AptReceipt'ten çıkın, yeni sürümü Applications (Uygulamalar) klasörüne sürükleyip Değiştir'i seçin."
          }
        }
      }
    },
